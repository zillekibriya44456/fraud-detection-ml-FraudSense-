    "print('Columns to KEEP:')\n",
    "keep = [c for c in df_ps.columns if c not in ['nameOrig', 'nameDest', 'isFlaggedFraud', 'isFraud']]\n",
    "for c in keep:\n",
    "    print(f'  {c}')\n",
    "print('  isFraud       — TARGET (y)')\n",
    "print()\n",
    "print('No target leakage identified in retained features.')"
