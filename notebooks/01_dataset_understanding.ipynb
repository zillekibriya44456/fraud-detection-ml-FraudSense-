   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Leakage analysis\n",
    "print('=== Potential Leakage Analysis ===')\n",
    "print('Columns to DROP before training:')\n",
    "print('  nameOrig      — customer identifier (high cardinality string)')\n",
    "print('  nameDest      — recipient identifier (high cardinality string)')\n",
    "print('  isFlaggedFraud — derived from amount threshold, NOT from actual fraud label')\n",
