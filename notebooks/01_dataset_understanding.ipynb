    "# isFlaggedFraud — simple business rule, not ML target\n",
    "print(f'\\nisFlaggedFraud unique values: {df_ps[\"isFlaggedFraud\"].unique()}')\n",
    "print(f'isFlaggedFraud = 1 count: {(df_ps[\"isFlaggedFraud\"] == 1).sum():,}')\n",
    "print('Note: isFlaggedFraud is a simple threshold rule (amount > 200,000).')\n",
    "print('It will be DROPPED before training — it is not our prediction target.')"
