    "df_ieee_sample = pd.read_csv(IEEE_TX_PATH, nrows=50_000, low_memory=False)\n",
    "print(f'Sample shape: {df_ieee_sample.shape[0]:,} rows × {df_ieee_sample.shape[1]} columns')"
