    "# Final summary visualisation — class imbalance comparison across datasets\n",
    "import matplotlib.patches as mpatches\n",
    "\n",
    "datasets = ['PaySim\\n(PRIMARY)', 'ULB Credit Card\\n(BENCHMARK)', 'IEEE-CIS\\n(SECONDARY)', 'UPI Fraud\\n(REJECTED)']\n",
    "fraud_pcts = [0.1291, 0.1727, 3.499, 17.22]\n",
    "colors = ['#2196F3', '#4CAF50', '#FF9800', '#9E9E9E']\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "bars = ax.barh(datasets, fraud_pcts, color=colors, edgecolor='white', linewidth=0.5)\n",
    "ax.axvline(x=5, color='red', linestyle='--', linewidth=1, label='5% reference line')\n",
    "ax.set_xlabel('Fraud Percentage (%)')\n",
    "ax.set_title('Dataset Fraud Rate Comparison\\n(lower = more realistic)', fontsize=13, fontweight='bold')\n",
    "for bar, pct in zip(bars, fraud_pcts):\n",
    "    ax.text(pct + 0.2, bar.get_y() + bar.get_height()/2,\n",
    "            f'{pct:.2f}%', va='center', fontsize=10)\n",
    "ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig('../reports/figures/dataset_fraud_rate_comparison.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print('Figure saved to reports/figures/')"
   ]
