    "\n",
    "# Fraud by transaction type (key insight)\n",
    "print('\\n=== Fraud counts by transaction type ===')\n",
    "fraud_by_type = df_ps.groupby('type')['isFraud'].agg(['sum', 'count', 'mean'])\n",
