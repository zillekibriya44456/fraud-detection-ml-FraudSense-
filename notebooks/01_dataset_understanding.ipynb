   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Schema - column groups\n",
    "cols = list(df_ieee_sample.columns)\n",
    "\n",
    "id_cols = [c for c in cols if c in ['TransactionID', 'TransactionDT']]\n",
    "categorical_cols = [c for c in cols if c in ['ProductCD', 'card4', 'card6',\n",
