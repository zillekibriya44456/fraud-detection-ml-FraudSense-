    "m_cols = [c for c in cols if c.startswith('M')]\n",
    "v_cols = [c for c in cols if c.startswith('V')]\n",
    "\n",
    "print(f'Total columns       : {len(cols)}')\n",
    "print(f'Identifier cols     : {id_cols}')\n",
    "print(f'Categorical cols    : {categorical_cols}')\n",
    "print(f'C (count) cols      : {len(c_cols)}  ({c_cols[0]}...{c_cols[-1]})')\n",
    "print(f'D (time delta) cols : {len(d_cols)}  ({d_cols[0]}...{d_cols[-1]})')\n",
