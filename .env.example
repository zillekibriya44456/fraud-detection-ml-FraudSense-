# Set to production for deployed environments. Production refuses to start
# unless API_KEY is set.
ENVIRONMENT=development

# SQLite is appropriate for local development. Use a managed PostgreSQL URL in
# production once migrations are introduced.
DATABASE_URL=sqlite:///./data/audit_log.db

# Absolute path inside the deployment containing the trained pre-authorization
# model and matching preprocessor.joblib.
MODEL_DIR=/app/models/pre_authorization

# Comma-separated browser origins. Do not use a wildcard in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for ENVIRONMENT=production. Store it in the platform secret manager.
API_KEY=replace-with-a-long-random-secret
